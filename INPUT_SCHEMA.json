    "customUrl": {
      "title": "Custom URL (optional)",
      "type": "string",
      "description": "Paste any iimjobs.com listing URL here to override the category dropdown. Use this for niche keyword pages not listed above, e.g. https://www.iimjobs.com/k/financial-planning-jobs",
      "editor": "textfield",
      "nullable": true
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Filter jobs by city. Leave empty to scrape all locations.",
      "editor": "select",
      "default": "",
      "enum": [
        "",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7"
      ],
      "enumTitles": [
        "All Locations",
        "Delhi NCR",
        "Mumbai",
        "Bangalore",
        "Hyderabad",
        "Kolkata",
        "Chennai",
        "Pune"
      ]
    },
    "minExperience": {
      "title": "Min Experience (years)",
      "type": "integer",
      "description": "Minimum years of experience. Leave at 0 for no minimum.",
      "default": 0,
      "minimum": 0,
      "maximum": 50
    },
    "maxExperience": {
      "title": "Max Experience (years)",
      "type": "integer",
      "description": "Maximum years of experience. Leave at 0 for no maximum.",
      "default": 0,
      "minimum": 0,
      "maximum": 50
