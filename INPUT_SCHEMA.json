    "postedWithin": {
      "title": "Posted Within",
      "type": "string",
      "description": "Only include jobs posted within this many days. Leave empty for all jobs.",
      "editor": "select",
      "default": "",
      "enum": ["", "1", "3", "7", "14", "30"],
      "enumTitles": [
        "Any time",
        "Last 24 hours",
        "Last 3 days",
        "Last 7 days",
        "Last 14 days",
        "Last 30 days"
      ]
    },
    "maxPages": {
      "title": "Max Pages",
      "type": "integer",
      "description": "Number of pages to scrape. Each page has ~50 jobs. Use 1 for a quick test, or up to 100 for a full scrape.",
      "default": 5,
      "minimum": 1,
      "maximum": 100,
      "prefill": 5
    }
