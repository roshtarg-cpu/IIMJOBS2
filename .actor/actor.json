{
  "actorSpecification": 1,
  "name": "iimjobs-scraper",
  "title": "IIMJobs Scraper",
  "description": "Scrape job listings from iimjobs.com — India's top job board for MBA, CA, CFA, and premium professionals. Extract title, company, salary, experience, location, skills, and more. Filter by category, city, experience level, industry, and recency.",
  "version": "1.0.0",
  "buildTag": "latest",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Job Listings",
      "description": "Structured job listing data scraped from iimjobs.com",
      "fields": {
        "title": {
          "type": "string",
          "title": "Job Title",
          "description": "The title of the job posting",
          "example": "Finance Director - BFSI - South Asia"
        },
        "company": {
          "type": "string",
          "title": "Company",
          "description": "Company name, or 'Confidential' for anonymized postings",
          "example": "Ecolab"
        },
        "experienceRange": {
          "type": "string",
          "title": "Experience Range",
          "description": "Required experience range in years",
          "example": "15 - 30 yrs"
        },
        "salaryRange": {
          "type": "string",
          "title": "Salary Range",
          "description": "Salary range in LPA (Lakhs Per Annum), empty if not disclosed",
          "example": "35-50 LPA"
        },
        "location": {
          "type": "string",
          "title": "Location",
          "description": "Job location city or cities",
          "example": "Mumbai"
        },
        "postedDate": {
          "type": "string",
          "title": "Posted Date",
          "description": "Relative posting date",
          "example": "Posted 2 days ago"
        },
        "skills": {
          "type": "array",
          "title": "Skills",
          "description": "Required skills and tags listed on the job",
          "example": ["CA", "Financial Planning", "Budgeting"]
        },
        "jobUrl": {
          "type": "string",
          "title": "Job URL",
          "description": "Direct URL to the job posting on iimjobs.com",
          "example": "https://www.iimjobs.com/j/finance-director-bfsi-1737225"
        },
        "jobId": {
          "type": "integer",
          "title": "Job ID",
          "description": "Unique numeric job identifier",
          "example": 1737225
        }
      },
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "title",
              "company",
              "experienceRange",
              "salaryRange",
              "location",
              "postedDate",
              "skills",
              "jobUrl",
              "jobId"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": { "label": "Job Title", "format": "text" },
              "company": { "label": "Company", "format": "text" },
              "experienceRange": { "label": "Experience", "format": "text" },
              "salaryRange": { "label": "Salary", "format": "text" },
              "location": { "label": "Location", "format": "text" },
              "postedDate": { "label": "Posted", "format": "text" },
              "skills": { "label": "Skills", "format": "array" },
              "jobUrl": { "label": "Job URL", "format": "link" },
              "jobId": { "label": "Job ID", "format": "number" }
            }
          }
        }
      }
    }
  }
}
